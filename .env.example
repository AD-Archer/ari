# local postgres from compose.yaml
DATABASE_URL=postgresql://ari:ari@localhost:5433/ari

# 32-byte base64 key: openssl rand -base64 32. must match ari-webhooks on a shared database
TOKEN_ENC_KEY=

# public origin of this app, used in the priority form link and mcp oauth discovery urls
BASE_URL=http://localhost:5173

# dev-only login at /auth/dev, ignored in production builds
DEV_LOGIN=true

# hack club auth (optional locally, required in production)
HC_AUTH_BASE=
HC_CLIENT_ID=
HC_CLIENT_SECRET=
HC_REDIRECT_URI=http://localhost:5173/auth/callback

# ari-webhooks internal api (optional). blank disables resync, file preview and live checks
WEBHOOKS_URL=
WEBHOOKS_INTERNAL_TOKEN=

# slack (optional). blank disables display-name lookup and channel sync
SLACK_BOT_TOKEN=
SLACK_EMBASSY_CHANNEL=
SLACK_POC_CHANNEL=

# slack avatar cache base url (optional). blank falls back to slack users.info
CACHET_URL=

# image uploads to an r2 bucket (optional). any one left blank disables uploads.
# endpoint is https://<account id>.r2.cloudflarestorage.com; public url is where the bucket is served
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# reviewer vms (optional). blank hides the vm ui
VM_API_BASE=
VM_API_TOKEN=

# sentry (optional)
PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
